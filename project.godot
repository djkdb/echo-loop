; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Echo Loop"
run/main_scene="uid://dpqv1gyde8368"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

ReplayIO="*res://autoload/replay_io.gd"
Sfx="*res://autoload/sfx.gd"
Progress="*res://autoload/progress.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/size/window_width_override.movie=0
window/size/window_height_override.movie=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="uid://ddexe0gwhqesb"

